# =============================================================================
# Sigilweaver Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
#
# Generate secrets with:
#   openssl rand -hex 32                           # For most secrets
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                                                  # For CONNECTION_ENCRYPTION_KEY
# =============================================================================

# =============================================================================
# REQUIRED - Security Secrets
# =============================================================================

# Session signing key - used to sign session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# JWT signing key - used for internal tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Credential encryption key - Fernet key for encrypting stored credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=

# Shared secret for server registration - servers must provide this to register
# Generate with: openssl rand -hex 32
SERVER_REGISTRATION_SECRET=

# PostgreSQL password
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# =============================================================================
# OPTIONAL - Configuration
# =============================================================================

# Version tag for images (default: latest)
# VERSION=1.0.0

# PostgreSQL settings (defaults shown)
# POSTGRES_USER=sigilweaver
# POSTGRES_DB=sigilweaver_hub

# External database URL (uncomment to use instead of bundled PostgreSQL)
# When set, the postgres service can be removed from docker-compose.yml
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# CORS origins - comma-separated list of allowed origins
# Example: https://app.example.com,https://admin.example.com
# CORS_ORIGINS=

# Hub external port (default: 25802)
# HUB_PORT=25802

# Logging level: debug, info, warning, error (default: info)
# LOG_LEVEL=info

# Logging format: text, json (default: text, use json for production log aggregation)
# LOG_FORMAT=json

# Server display name in Hub (default: server-<hostname>)
# SERVER_NAME=production-server-1

# =============================================================================
# DEVELOPMENT ONLY - Do not use in production
# =============================================================================

# These are example values for local testing ONLY
# Never commit real secrets to version control!

# Example (DO NOT USE IN PRODUCTION):
# SESSION_SECRET=dev-session-secret-do-not-use-in-production
# SECRET_KEY=dev-secret-key-do-not-use-in-production
# CONNECTION_ENCRYPTION_KEY=ZGV2LWVuY3J5cHRpb24ta2V5LWRvLW5vdC11c2U=
# SERVER_REGISTRATION_SECRET=dev-registration-secret
# POSTGRES_PASSWORD=dev-password
