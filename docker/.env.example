# =============================================================================
# Sigilweaver Loom Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
#
# Generate secrets with:
#   openssl rand -hex 32                           # For most secrets
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                                                  # For CONNECTION_ENCRYPTION_KEY
# =============================================================================

# =============================================================================
# REQUIRED - Security Secrets
# =============================================================================

# Session signing key - used to sign session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# JWT signing key - used for internal tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Credential encryption key - Fernet key for encrypting stored credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=

# Shared secret for server registration - servers must provide this to register
# Generate with: openssl rand -hex 32
SERVER_REGISTRATION_SECRET=

# PostgreSQL password
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# =============================================================================
# OPTIONAL - Configuration
# =============================================================================

# Version tag for images (default: latest)
# VERSION=1.0.0

# PostgreSQL settings (defaults shown)
# POSTGRES_USER=sigilweaver_loom
# POSTGRES_DB=sigilweaver_loom_hub

# External database URL (uncomment to use instead of bundled PostgreSQL)
# When set, the postgres service can be removed from docker-compose.yml
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# CORS origins - JSON array of allowed browser origins.
# pydantic-settings parses this as JSON, so it MUST be a JSON array (not a
# comma-separated list). An empty value will fail to parse.
# Example: CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
# CORS_ORIGINS=["http://localhost:25803","http://localhost:25810"]

# Hub external port (default: 25802)
# HUB_PORT=25802

# =============================================================================
# OPTIONAL - TLS Reverse Proxy (docker-compose.tls.yml)
# =============================================================================
# Used only when starting with the Caddy overlay:
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d

# Public hostname that resolves to this host (required for the TLS overlay).
# CADDY_DOMAIN=loom.example.com

# Email for ACME/Let's Encrypt certificate notifications (required for TLS).
# ACME_EMAIL=admin@example.com

# ACME directory URL. Use the staging URL while testing to avoid rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
# CADDY_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# When fronting with Caddy, bind the app ports to loopback so only Caddy
# (80/443) is internet-facing. Caddy reaches the Hub over the Docker network.
# HUB_PORT=127.0.0.1:25802
# SERVER_PORT=127.0.0.1:25811

# =============================================================================
# OPTIONAL - Server identity (advertised to the Hub)
# =============================================================================

# Public URL the Hub should use to reach this server for health polling and
# execution dispatch. Set when the Hub cannot reach the server at its bind
# address, e.g. across a Tailscale tailnet (use the MagicDNS name).
# PUBLIC_ENDPOINT_URL=http://my-server.tailnet-name.ts.net:25811

# Logging level: debug, info, warning, error (default: info)
# LOG_LEVEL=info

# Logging format is hardcoded to json in docker-compose.yml for log
# aggregation; it is not configurable via this file.

# Server display name in Hub (default: server-<hostname>)
# SERVER_NAME=production-server-1

# =============================================================================
# DEVELOPMENT ONLY - Do not use in production
# =============================================================================

# These are example values for local testing ONLY
# Never commit real secrets to version control!

# Example (DO NOT USE IN PRODUCTION):
# SESSION_SECRET=dev-session-secret-do-not-use-in-production
# SECRET_KEY=dev-secret-key-do-not-use-in-production
# CONNECTION_ENCRYPTION_KEY=ZGV2LWVuY3J5cHRpb24ta2V5LWRvLW5vdC11c2U=
# SERVER_REGISTRATION_SECRET=dev-registration-secret
# POSTGRES_PASSWORD=dev-password
