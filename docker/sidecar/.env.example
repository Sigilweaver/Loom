# Tailscale sidecar - .env for the remote Loom Server
# Copy to .env and fill in. Do not commit real secrets.

# --- Tailscale ---
# Auth key from https://login.tailscale.com -> Settings -> Keys
# (reusable + ephemeral recommended for disposable hosts).
TS_AUTHKEY=

# Hostname for this node on the tailnet -> <TS_HOSTNAME>.<TS_TAILNET>.ts.net
TS_HOSTNAME=loom-server

# Your tailnet name (e.g. "tomato-walrus" or "example.com" for custom tailnets).
# Find it in the Tailscale admin console (DNS page, "Tailnet name").
TS_TAILNET=

# --- Hub connection ---
# Hub MagicDNS URL on the tailnet.
HUB_URL=http://loom-hub.tailnet-name.ts.net:25802

# Shared registration secret (matches the Hub's SERVER_REGISTRATION_SECRET).
HUB_REGISTRATION_SECRET=

# This server's auth token registered in the Hub.
HUB_SERVER_TOKEN=

# --- Server identity / data ---
SERVER_NAME=remote-server-1

# Host directory of data files this server may read (mounted read-only).
SERVER_DATA_DIR=./data

# Image version tag (default: latest)
# VERSION=1.0.0
