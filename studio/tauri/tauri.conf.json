{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Sigilweaver Loom",
    "version": "0.0.0",
    "identifier": "com.sigilweaver.loom-studio",
    "build": {
        "beforeDevCommand": "",
        "devUrl": "http://localhost:25810",
        "beforeBuildCommand": "bun run build:web",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "title": "Sigilweaver Loom Studio",
                "width": 1200,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "transparent": false,
                "center": true,
                "visible": false,
                "create": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https: ws://localhost:* ws://127.0.0.1:* wss:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
            "capabilities": [
                "main-capability"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "rpm",
            "appimage",
            "nsis",
            "dmg",
            "app"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [],
        "externalBin": [],
        "category": "DeveloperTool",
        "shortDescription": "Visual workflow designer for data pipelines",
        "longDescription": "Sigilweaver Loom Studio is a visual workflow designer for building data pipelines using Polars.",
        "linux": {
            "appimage": {
                "bundleMediaFramework": false
            },
            "deb": {
                "depends": []
            }
        },
        "macOS": {
            "minimumSystemVersion": "10.15",
            "exceptionDomain": null,
            "signingIdentity": null,
            "entitlements": null
        },
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": null,
            "wix": null,
            "nsis": {
                "installerIcon": "icons/icon.ico",
                "installMode": "currentUser"
            }
        }
    }
}
