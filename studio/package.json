{
  "name": "sigilweaver-loom-studio",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Sigilweaver Loom - Advanced Workflow Designer and Automation Tool",
  "author": "Sigilweaver Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sigilweaver/Loom.git"
  },
  "type": "module",
  "overrides": {
    "nanoid": "^3.3.18",
    "fast-uri": "^3.1.8",
    "js-yaml": "^4.3.2",
    "@xmldom/xmldom": "^0.8.15",
    "http-cache-semantics": "^4.3.0",
    "source-map-js": "^1.2.2",
    "dompurify": "^3.4.17",
    "follow-redirects": "^1.16.1",
    "zod": "^4.6.7",
    "undici": "^7.30.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "tauri build",
    "build:web": "tsc && vite build",
    "build:tauri": "tauri build",
    "build:web:zip": "bun run build:web && cd dist && zip -r ../dist-web.zip .",
    "preview": "vite preview",
    "tauri": "tauri",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:install": "bun run clean && bun install",
    "analyze": "bun run build:web && bun x vite-bundle-analyzer dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/domain src/state",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ui": "vitest --ui",
    "verify": "bun run --silent type-check && bun run --silent test && bun run --silent lint",
    "verify:quick": "bun run --silent type-check && bun run --silent test",
    "build:tauri:full": "tauri build --features bundled-server -c tauri/tauri.conf.full.json",
    "bundle:tauri": "tauri bundle",
    "bundle:tauri:full": "tauri bundle --features bundled-server -c tauri/tauri.conf.full.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/google": "^4.0.105",
    "@ai-sdk/mistral": "^4.0.72",
    "@ai-sdk/openai": "^4.0.102",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "^2.12.4",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.153",
    "clsx": "^2.1.0",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "immer": "^11.2.9",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^3.3.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.2.4",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^5.0.5"
  }
}
