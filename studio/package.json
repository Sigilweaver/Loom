{
  "name": "sigilweaver-loom-studio",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Sigilweaver Loom - Advanced Workflow Designer and Automation Tool",
  "author": "Sigilweaver Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sigilweaver/Loom.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "NO_ELECTRON=0 vite",
    "dev:tauri": "tauri dev",
    "build": "tsc && vite build && electron-builder",
    "build:web": "tsc && vite build",
    "build:electron": "electron-builder",
    "build:tauri": "tauri build",
    "build:linux": "bun run build:web && electron-builder --linux --publish=never",
    "build:win": "bun run build:web && electron-builder --win --publish=never",
    "build:mac": "bun run build:web && electron-builder --mac --publish=never",
    "build:linux:client": "bun run build:web && electron-builder --linux --config electron-builder-client.json --publish=never",
    "build:linux:full": "bun run build:web && electron-builder --linux --config electron-builder-full.json --publish=never",
    "build:win:client": "bun run build:web && electron-builder --win --config electron-builder-client.json --publish=never",
    "build:win:full": "bun run build:web && electron-builder --win --config electron-builder-full.json --publish=never",
    "build:mac:client": "bun run build:web && electron-builder --mac --config electron-builder-client.json --publish=never",
    "build:mac:full": "bun run build:web && electron-builder --mac --config electron-builder-full.json --publish=never",
    "build:tauri:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "build:tauri:win": "tauri build --target x86_64-pc-windows-msvc",
    "build:tauri:mac": "tauri build --target x86_64-apple-darwin",
    "build:web:zip": "bun run build:web && cd dist && zip -r ../dist-web.zip .",
    "preview": "vite preview",
    "electron": "wait-on tcp:25810 && cross-env IS_DEV=true electron . --enable-features=UseOzonePlatform,WaylandWindowDecorations --ozone-platform-hint=auto",
    "tauri": "tauri",
    "electron:pack": "electron-builder --dir",
    "preelectron:pack": "bun run build:web",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:ci": "eslint . --ext ts,tsx --report-unused-disable-directives || echo 'Linting completed with issues - see output above'",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rm -rf dist dist-electron node_modules/.vite",
    "clean:install": "bun run clean && bun install",
    "analyze": "bun run build:web && bun x vite-bundle-analyzer dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/domain src/state",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ui": "vitest --ui",
    "verify": "bun run -s type-check && bun run -s test && bun run -s lint",
    "verify:quick": "bun run -s type-check && bun run -s test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.44",
    "@ai-sdk/google": "^3.0.29",
    "@ai-sdk/mistral": "^3.0.20",
    "@ai-sdk/openai": "^3.0.29",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@xyflow/react": "^12.9.3",
    "ai": "^6.0.86",
    "clsx": "^2.1.0",
    "electron-store": "^11.0.2",
    "lucide": "^0.556.0",
    "lucide-react": "^0.556.0",
    "monaco-editor": "^0.56.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.1",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-istanbul": "^4.0.18",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "immer": "^11.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "prettier": "^3.2.5",
    "simple-icons": "^16.3.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.sigilweaver.loom",
    "productName": "Sigilweaver Loom",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/assets/**/*",
      "!public/assets/generate-favicon.js"
    ],
    "extraResources": [
      {
        "from": "../server/dist/",
        "to": "server/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "icon": "public/assets/icon-512.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Sigilweaver Development Team",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/assets/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sigilweaver Loom"
    }
  }
}
