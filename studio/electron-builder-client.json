{
  "appId": "com.sigilweaver.workflow-designer-client",
  "productName": "Sigilweaver-Client",
  "publish": null,
  "directories": {
    "output": "dist"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "public/assets/**/*",
    "!public/assets/generate-favicon.js"
  ],
  "extraResources": [],
  "linux": {
    "icon": "public/assets/icon-512.png",
    "category": "Development",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "snap",
        "arch": ["x64"]
      }
    ]
  },
  "win": {
    "icon": "public/assets/app-icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "verifyUpdateCodeSignature": false
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg"],
    "icon": "public/assets/icon-512.png"
  },
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sigilweaver Client"
  },
  "snap": {
    "confinement": "strict"
  }
}
