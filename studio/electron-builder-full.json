{
  "productName": "Sigilweaver",
  "appId": "com.sigilweaver.workflow-designer",
  "publish": null,
  "directories": {
    "output": "dist"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "public/assets/**/*",
    "!public/assets/generate-favicon.js"
  ],
  "extraResources": [
    {
      "from": "resources/server/",
      "to": "server/",
      "filter": [
        "**/*"
      ]
    }
  ],
  "linux": {
    "icon": "public/assets/icon-512.png",
    "category": "Development",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "snap",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "win": {
    "icon": "public/assets/app-icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sigilweaver"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      "dmg"
    ],
    "icon": "public/assets/icon-512.png"
  },
  "snap": {
    "confinement": "classic"
  }
}