# Server Configuration
HOST=0.0.0.0
PORT=58000
RELOAD=true
LOG_LEVEL=debug

# CORS Configuration
# Mode: "development" allows all origins (for bundled desktop app)
#       "production" uses CORS_ORIGINS list (for external server deployment)
CORS_MODE=development
CORS_ORIGINS=["http://localhost:5173"]

# Execution Limits
MAX_EXECUTION_TIME_SECONDS=300
MAX_MEMORY_MB=4096
MAX_PREVIEW_ROWS=10000

# File Access (JSON array format for list parsing)
# In hub mode, file access is controlled by Hub grants in addition to this setting
RESTRICT_FILE_ACCESS=false
ALLOWED_FILE_PATHS=[]

# Authentication Configuration
# Mode: "disabled" (no auth), "ephemeral" (Electron-generated token), "static" (env token)
# In desktop mode, Electron sets AUTH_MODE=ephemeral and SESSION_TOKEN automatically
AUTH_MODE=disabled
# For static mode, set your own token here:
# SESSION_TOKEN=your-secure-token-here
# Protect documentation endpoints (/docs, /redoc, /openapi.json)
AUTH_PROTECT_DOCS=true
# Protect health endpoint (/api/health/)
AUTH_PROTECT_HEALTH=true

# Workflow Archive Configuration
ARCHIVE_ENABLED=true
ARCHIVE_PATH=./audit/workflows
ARCHIVE_RETENTION_DAYS=30

# Audit Logging Configuration
AUDIT_ENABLED=true
AUDIT_PATH=./audit/logs
AUDIT_RETENTION_DAYS=30
