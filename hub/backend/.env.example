# =============================================================================
# Sigilweaver Loom Hub Backend Environment Configuration
# =============================================================================
# Copy this file to `.env` (same directory) and fill in the required values.
# `.env` is gitignored; `.env.example` is not.
#
# Generate secrets with:
#   openssl rand -hex 32                         # for SESSION_SECRET / SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                                                # for CONNECTION_ENCRYPTION_KEY
#   openssl genrsa -out private.pem 2048         # for JWT_PRIVATE_KEY (paste PEM)
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=25802
RELOAD=false
LOG_LEVEL=info
LOG_FORMAT=text
ENVIRONMENT=development

# Serve the compiled Hub frontend from this path (leave empty in dev)
STATIC_FILES_PATH=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# JSON list of allowed origins. Defaults cover the Hub frontend and Studio.
CORS_ORIGINS=["http://localhost:25803","http://localhost:25810"]

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sigilweaver_loom:sigilweaver_loom@localhost:25801/sigilweaver_loom_hub

# -----------------------------------------------------------------------------
# Authentication — Session
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION
SESSION_LIFETIME_HOURS=24

# -----------------------------------------------------------------------------
# Authentication — Legacy JWT (scheduled for removal)
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# Server polling
# -----------------------------------------------------------------------------
SERVER_POLL_INTERVAL_SECONDS=30
SERVER_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Workflow storage
# -----------------------------------------------------------------------------
WORKFLOW_STORAGE_PATH=./workflows

# -----------------------------------------------------------------------------
# Server Token (Capability) Settings
# -----------------------------------------------------------------------------
# RSA private key in PEM format for signing server tokens.
# If left empty, an ephemeral key is generated per process and tokens are
# invalidated on restart.
JWT_PRIVATE_KEY=
JWT_ISSUER=sigilweaver-loom-hub
SERVER_TOKEN_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Connection Storage
# -----------------------------------------------------------------------------
# REQUIRED in production. Fernet key for encrypting stored credentials.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Server Registration
# -----------------------------------------------------------------------------
# Shared secret that remote servers must present to register with Hub.
# If empty, server registration is OPEN — dev only.
SERVER_REGISTRATION_SECRET=
