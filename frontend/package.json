{
  "name": "sigilweaver",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Sigilweaver - Advanced Workflow Designer and Automation Tool",
  "author": "Sigilweaver Development Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigilweaver/sigilweaver-app.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:web": "tsc && vite build",
    "build:electron": "electron-builder",
    "build:linux": "npm run build:web && electron-builder --linux --publish=never",
    "build:win": "npm run build:web && electron-builder --win --publish=never",
    "build:mac": "npm run build:web && electron-builder --mac --publish=never",
    "build:linux:client": "npm run build:web && electron-builder --linux --config electron-builder-client.json --publish=never",
    "build:linux:full": "npm run build:web && electron-builder --linux --config electron-builder-full.json --publish=never",
    "build:win:client": "npm run build:web && electron-builder --win --config electron-builder-client.json --publish=never",
    "build:win:full": "npm run build:web && electron-builder --win --config electron-builder-full.json --publish=never",
    "build:mac:client": "npm run build:web && electron-builder --mac --config electron-builder-client.json --publish=never",
    "build:mac:full": "npm run build:web && electron-builder --mac --config electron-builder-full.json --publish=never",
    "build:web:zip": "npm run build:web && cd dist && zip -r ../dist-web.zip .",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && cross-env IS_DEV=true electron .",
    "electron:pack": "electron-builder --dir",
    "preelectron:pack": "npm run build:web",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:ci": "eslint . --ext ts,tsx --report-unused-disable-directives || echo 'Linting completed with issues - see output above'",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rm -rf dist dist-electron node_modules/.vite",
    "clean:install": "npm run clean && npm install",
    "analyze": "npm run build:web && npx vite-bundle-analyzer dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/domain src/state",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ui": "vitest --ui",
    "verify": "npm run -s type-check && npm run -s test && npm run -s lint",
    "verify:quick": "npm run -s type-check && npm run -s test"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.8.2",
    "clsx": "^2.1.0",
    "immer": "^10.1.3",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.0.16",
    "remark-gfm": "^4.0.1",
    "uuid": "^9.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.32",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.sigilweaver.workflow-designer",
    "productName": "Sigilweaver",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/assets/**/*",
      "!public/assets/generate-favicon.js"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "icon": "public/assets/icon-512.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "SigilWeaver Development Team",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/assets/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sigilweaver"
    }
  }
}
