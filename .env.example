# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=debug

# CORS Configuration (JSON array format for list parsing)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Execution Limits
MAX_EXECUTION_TIME_SECONDS=300
MAX_MEMORY_MB=4096
MAX_PREVIEW_ROWS=10000

# File Access (JSON array format for list parsing)
ALLOWED_FILE_PATHS=["/home","/data"]
RESTRICT_FILE_ACCESS=false
